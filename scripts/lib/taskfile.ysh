var _task_file = $(realpath "$0")
var _project_root = $(dirname "$_task_file")
var _task_source = $(cat "$_task_file")
var _task_docs = []
var _pending_doc = {}
var _doc_section = ''

for line in (_task_source.split(u'\n')) {
	var trimmed = line.trim()

	if (trimmed.startsWith('## usage: ')) {
		setvar _pending_doc['usage'] = trimmed[10:]
		setvar _doc_section = ''
	} elif (trimmed.startsWith('## category: ')) {
		setvar _pending_doc['category'] = trimmed[13:]
		setvar _doc_section = ''
	} elif (trimmed.startsWith('## visibility: ')) {
		setvar _pending_doc['visibility'] = trimmed[15:]
		setvar _doc_section = ''
	} elif (trimmed.startsWith('## summary: ')) {
		setvar _pending_doc['summary'] = trimmed[12:]
		setvar _doc_section = ''
	} elif (trimmed === '## description:') {
		setvar _doc_section = 'description'
	} elif (trimmed === '## options:') {
		setvar _doc_section = 'options'
	} elif (trimmed === '## examples:') {
		setvar _doc_section = 'examples'
	} elif (trimmed.startsWith('##') and _doc_section) {
		var detail = trimmed[3:]
		var existing = get(_pending_doc, _doc_section, '')
		if (existing) {
			setvar _pending_doc[_doc_section] = existing ++ u'\n' ++ detail
		} else {
			setvar _pending_doc[_doc_section] = detail
		}
	} elif (trimmed.startsWith('proc ')) {
		var declaration = trimmed[5:]
		var name = declaration.split(u' ')[0]
		var name_end = name.find('(')
		if (name_end >= 0) {
			setvar name = name[:name_end]
		}
		if (not name.startsWith('_')) {
			setvar _pending_doc['name'] = name
			call _task_docs->append(_pending_doc)
		}
		setvar _pending_doc = {}
		setvar _doc_section = ''
	}
}

proc _print-task-list {
	var terminal = false
	var color = false
	if test -t 1 {
		setvar terminal = true
		if (not get(ENV, 'NO_COLOR') and get(ENV, 'TERM') !== 'dumb') {
			setvar color = true
		}
	}

	if (terminal) {
		if (color) {
			printf '  \033[1;36mOPENCONNECT CLIENT\033[0m\n'
			printf '  \033[1;35mBuild, test, and manage your development workflow.\033[0m\n'
			printf '\033[2;36m%s\033[0m\n' '  -------------------------------------------------'
		} else {
			write -- '  OPENCONNECT CLIENT'
			write -- '  Build, test, and manage your development workflow.'
			write -- '  -------------------------------------------------'
		}
	} else {
		write -- 'OPENCONNECT CLIENT'
		write -- 'Build, test, and manage your development workflow.'
		write -- '-------------------------------------------------'
	}

	var categories = []
	var seen_categories = {}
	for doc in (_task_docs) {
		if (get(doc, 'visibility', 'public') !== 'internal') {
			var category = get(doc, 'category', 'Other')
			if (not get(seen_categories, category, false)) {
				call categories->append(category)
				setvar seen_categories[category] = true
			}
		}
	}

	for category in (categories) {
		write -- ''
		if (color) {
			printf '  \033[1;34m%s\033[0m\n' "$category"
		} elif (terminal) {
			write -- "  $category"
		} else {
			write -- "$category"
		}
		for doc in (_task_docs) {
			if (get(doc, 'visibility', 'public') === 'internal' or
			    get(doc, 'category', 'Other') !== category) {
				continue
			}
			if (color) {
				printf '    \033[1;32m%-12s\033[0m \033[2m|\033[0m %s\n' "$[doc.name]" "$[get(doc, 'summary', 'No description available')]"
			} elif (terminal) {
				printf '    %-12s | %s\n' "$[doc.name]" "$[get(doc, 'summary', 'No description available')]"
			} else {
				write -- "  $[doc.name] - $[get(doc, 'summary', 'No description available')]"
			}
		}
	}

	if (len(categories) === 0) {
		write -- ''
		write -- 'No project tasks are available yet.'
		write -- 'Project tasks will appear here as they are added.'
	} else {
		write -- ''
		if (color) {
			printf '  \033[2mRun\033[0m \033[1;33m./run.ysh TASK -h\033[0m \033[2mor\033[0m \033[1;33m./run.ysh TASK --help\033[0m \033[2mfor details.\033[0m\n'
		} elif (terminal) {
			write -- '  Run ./run.ysh TASK -h or ./run.ysh TASK --help for details.'
		} else {
			write -- 'Run ./run.ysh TASK -h or ./run.ysh TASK --help for details.'
		}
	}
}

proc _print-task-help(task_name) {
	for doc in (_task_docs) {
		if (doc.name === task_name) {
			var usage = get(doc, 'usage', "$task_name [ARG...]")
			write -- "USAGE: $usage"
			write -- $[get(doc, 'summary', '')]
			var description = get(doc, 'description', '').trim()
			if (description) {
				write -- ''
				write -- 'DESCRIPTION:'
				write -- $description
			}
			var options = get(doc, 'options', '').trim()
			if (options) {
				write -- ''
				write -- 'OPTIONS:'
				write -- $options
			}
			var examples = get(doc, 'examples', '').trim()
			if (examples) {
				write -- ''
				write -- 'EXAMPLES:'
				write -- $examples
			}
			return
		}
	}

	printf 'Error: no task named "%s". Run "./run.ysh list-tasks" to see available tasks.\n' "$task_name" >&2
	exit 2
}

if (len(ARGV) === 0) {
	_prepare_go_toolchain
	_print-task-list
	exit
}

if (ARGV[0] === 'list-tasks' or ARGV[0] === '--help' or ARGV[0] === '-h') {
	_print-task-list
	exit
}

if (ARGV[0] === 'help') {
	if (len(ARGV) === 1) {
		_print-task-list
	} else {
		_print-task-help $[ARGV[1]]
	}
	exit
}

if (len(ARGV) > 1 and (ARGV[1] === '--help' or ARGV[1] === '-h')) {
	_print-task-help $[ARGV[0]]
	exit
}

if (len(ARGV) === 3 and ARGV[0] === 'unit' and ARGV[1] === 'test' and
    (ARGV[2] === '--help' or ARGV[2] === '-h')) {
	_print-task-help 'unit'
	exit
}

var task_found = false
for doc in (_task_docs) {
	if (doc.name === ARGV[0]) {
		setvar task_found = true
		break
	}
}
if (not task_found) {
	printf 'Error: unknown task "%s".\n' "$[ARGV[0]]" >&2
	_print-task-list >&2
	exit 2
}

_prepare_go_toolchain
@ARGV
