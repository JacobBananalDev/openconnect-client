#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

exec 1>&2

if git rev-parse --verify HEAD >/dev/null 2>&1; then
	against=HEAD
else
	against=$(git hash-object -t tree /dev/null)
fi

if [ "$(git config --type=bool hooks.allownonascii)" != "true" ] &&
	[ "$(git diff --cached --name-only --diff-filter=A -z "$against" |
		LC_ALL=C tr -d '[ -~]\0' | wc -c)" -ne 0 ]
then
	echo "Error: non-ASCII staged file name." >&2
	echo "Rename the file or run: git config hooks.allownonascii true" >&2
	exit 1
fi

# Check only staged paths that will enter this commit.
git diff --cached --name-only --diff-filter=ACMR "$against" -- |
	while IFS= read -r path; do
		base=${path##*/}
		base=$(printf '%s' "$base" |
			tr '[:lower:]' '[:upper:]')
		base=${base%.*}
		case "$base" in
			CON|PRN|AUX|NUL|CLOCK\$|COM[0-9]|LPT[0-9])
				echo "Error: Windows-reserved staged file name: '$path'" >&2
				exit 1
				;;
		esac
	done

./run.ysh fmt
./run.ysh lint
./run.ysh unit-test
./run.ysh vuln

exec git diff-index --check --cached "$against" --
